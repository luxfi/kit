{
  "name": "luxkit",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "react": [
        "dist/index.react.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/index.react.d.ts",
      "import": {
        "types": "./dist/index.react.d.ts",
        "default": "./dist/index.react.js"
      },
      "default": "./dist/index.react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rollup -c rollup.config.ts -w --configPlugin swc3 --bundleConfigAsCjs",
    "build": "rm -rf ./dist &&rollup -c rollup.config.ts --configPlugin swc3 --bundleConfigAsCjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [],
  "license": "ISC",
  "peerDependencies": {
    "@wagmi/core": "2.x",
    "viem": "2.x",
    "wagmi": "2.x"
  },
  "dependencies": {
    "clsx": "catalog:",
    "dequal": "catalog:",
    "mipd": "catalog:",
    "qrcode": "catalog:",
    "react": "catalog:",
    "svelte": "catalog:",
    "svelte-i18n": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-dynamic-import-vars": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-copy": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-polyfill-node": "catalog:",
    "rollup-plugin-svelte": "catalog:",
    "rollup-plugin-svgo": "catalog:",
    "rollup-plugin-swc3": "catalog:",
    "rollup-plugin-typescript2": "catalog:",
    "rollup-swc-preserve-directives": "catalog:",
    "sass": "catalog:",
    "svelte-preprocess": "catalog:"
  }
}
